# ---------------------------------------------------------------------------
# NERTO Homes — environment
#
# Copy to `.env.local` (git-ignored) and fill in. Nothing here is required for
# the site to build or run: with none of it set, a lead is written to the
# server log rather than lost, and the chat widget still works.
#
# After filling in the two GHL variables, create the CRM's fields with:
#   npm run ghl:check     # what exists, what is missing — changes nothing
#   npm run ghl:setup     # create the contact fields, write the custom values
# ---------------------------------------------------------------------------

# The canonical domain. Used for metadata, OG images, the sitemap, and the
# listing links sent to the CRM. `npm run lint` fails while this is unset on a
# production build, so set it before going live.
NEXT_PUBLIC_SITE_URL="https://www.newenglandrenttoown.com"

# --- GoHighLevel ------------------------------------------------------------
# A Private Integration Token for the sub-account: GHL → Settings → Private
# Integrations → Create new integration. It starts `pit-`. An agency token or
# an OAuth access token works too, as long as it is scoped to this location.
#
# Scopes to tick:
#   contacts.readonly            contacts.write
#   locations/customFields.readonly   locations/customFields.write
#   locations/customValues.readonly   locations/customValues.write
#   opportunities.write          (only if you set the pipeline variables below)
GHL_API_TOKEN=""

# Sub-account ID. GHL → Settings → Business Profile, or the string in the URL
# after /location/ while you are inside the sub-account.
GHL_LOCATION_ID=""

# The API version the token was issued against. Leave unset unless GHL tells
# you otherwise — `2021-07-28` is the default and is what this site sends. Set
# it to `v3` only if your integration is issued for v3; it changes the shape
# of the custom-field payload as well as the header.
# GHL_API_VERSION="2021-07-28"

# Optional. Set BOTH and every website lead also opens an opportunity in that
# pipeline stage. Get the ids from GHL → Opportunities → Pipelines, or the API.
# GHL_PIPELINE_ID=""
# GHL_PIPELINE_STAGE_ID=""

# Optional. Comma-separated tags added to every contact the site creates, on
# top of `website` and the per-form tag.
# GHL_DEFAULT_TAGS="website,2026-site"

# Optional, and for testing only: send every GHL request somewhere else — a
# local stub — so the integration can be exercised without a live account.
# GHL_API_BASE="http://127.0.0.1:4600"

# --- Second copy of every lead ---------------------------------------------
# Optional and independent of the above. Every lead is also POSTed here as
# JSON — an inbound GHL webhook, a Zap, a Make scenario, a spreadsheet. Two
# sinks is how you notice the CRM has stopped accepting leads.
# LEAD_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/..."
